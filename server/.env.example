# @devdigest/api environment
DATABASE_URL=postgres://devdigest:devdigest@localhost:5555/devdigest

# LLM providers (BYO key — entered via Settings UI in prod; env for local dev).
# Optional: the app boots with none. A key is only needed for the provider you
# actually run a review on (or embeddings, see EMBEDDINGS_ENABLED).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# GitHub (REST via Octokit) — PAT with repo scope. Canonical name is
# GITHUB_TOKEN; GITHUB_PAT is still accepted as a fallback for back-compat.
GITHUB_TOKEN=

# Memory/RAG embeddings (OpenAI text-embedding-3-small). Default OFF → the app
# makes ZERO OpenAI requests. Set true to enable memory retrieval.
EMBEDDINGS_ENABLED=false

# repo-intel facade (Tier 1: repo skeleton + callers in the review prompt).
# Default ON; set false to degrade every consumer to ripgrep-only behavior.
REPO_INTEL_ENABLED=true

# Project Context (view-only repo docs attached to agents/skills). Comma-separated
# FOLDER NAMES (not globs); every .md under a folder with one of these names, at any
# depth of the synced default-branch clone, is discoverable. Defaults shown.
# Use `*` to list every .md in the repo (type = top-level folder, `root` at the top).
# PROJECT_CONTEXT_ROOTS=specs,docs,insights
PROJECT_CONTEXT_ROOTS=*
# The UI warns (never truncates) when attached documents exceed this many tokens.
PROJECT_CONTEXT_WARN_TOKENS=200000

API_PORT=3001
WEB_PORT=3005
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (defaults: info, silent in test)
# LOCAL-ONLY: extra prompt-composition diagnostics on the server's stdout (content hashes,
# line counts, short redacted previews of title/task/file-list only). Never diffs, PR
# descriptions, issue/plan/spec bodies. Ignored unless NODE_ENV=development. Needs LOG_LEVEL=info+.
# DEVDIGEST_PROMPT_LOG_VERBOSE=true
LOG_LEVEL=
DEVDIGEST_CLONE_DIR=./clones
