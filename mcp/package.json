{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server — local stdio MCP server exposing five tools over the DevDigest HTTP API. Thin translation layer: no business logic, no DB. Contracts are consumed from server/src/vendor/shared via a tsconfig path alias.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector -e DEVDIGEST_API_URL=${DEVDIGEST_API_URL:-http://127.0.0.1:3001} -e DEVDIGEST_MCP_WAIT_MS=${DEVDIGEST_MCP_WAIT_MS:-120000} tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "js-tiktoken": "^1.0.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
